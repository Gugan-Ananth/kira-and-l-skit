# Copy to .env if you want. The process also reads these from the environment.
# Bind stays on this machine unless you set a password first.
SKIT_HOST=127.0.0.1
SKIT_PORT=8765
# Required when SKIT_HOST is not localhost.
SKIT_PASSWORD=
# f5 or chatterbox. f5 is the likeness default until you listen to both.
SKIT_ENGINE=f5
# Optional overrides.
# SKIT_F5_STEPS=8
# SKIT_F5_METHOD=rk4
# SKIT_CHATTERBOX_MODEL=mlx-community/chatterbox-4bit
